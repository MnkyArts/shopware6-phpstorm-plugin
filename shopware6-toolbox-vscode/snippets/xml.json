{
  "Shopware Config Base": {
    "prefix": "sw-config-base",
    "body": [
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
      "<config xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"",
      "        xsi:noNamespaceSchemaLocation=\"https://raw.githubusercontent.com/shopware/platform/trunk/src/Core/System/SystemConfig/Schema/config.xsd\">",
      "",
      "    <card>",
      "        <title>${1:Card Title}</title>",
      "",
      "        ${2:<!-- Add input fields here -->}",
      "    </card>",
      "</config>"
    ],
    "description": "Create base config.xml structure"
  },
  "Shopware Config Element Bool": {
    "prefix": "sw-config-element-bool",
    "body": [
      "<input-field type=\"bool\">",
      "    <name>${1:fieldName}</name>",
      "    <label>${2:Field Label}</label>",
      "</input-field>"
    ],
    "description": "Add boolean input field"
  },
  "Shopware Config Element Checkbox": {
